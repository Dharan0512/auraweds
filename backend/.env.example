# ----- Server -----
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed browser origins (overrides FRONTEND_URL)
ALLOWED_ORIGINS=http://localhost:3000

# ----- Database (PostgreSQL is the active database) -----
POSTGRES_URI=postgres://postgres:postgres@localhost:5432/auraweds

# ----- Auth -----
# Use a long random string (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_secret
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ----- File Upload -----
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# ----- Logging -----
LOG_LEVEL=info

# Supabase Storage (image storage) — required in production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads
